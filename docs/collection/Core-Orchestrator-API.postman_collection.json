{
	"info": {
		"_postman_id": "core-orchestrator-api-v2",
		"name": "Core Orchestrator API (V2 - Atualizado)",
		"description": "API do Core Orchestrator - Backend principal com lógica de negócio e integração com blockchain via RabbitMQ\n\n## Arquitetura\n- Spring Boot 3.3.5 + PostgreSQL\n- Autenticação JWT\n- Queue async para blockchain (RabbitMQ)\n- Webhooks para sincronização com blockchain\n\n## Variáveis\nConfigure no Environment:\n- `baseUrl`: http://localhost:8080\n- `jwt_token`: Token JWT (obtido no login)\n- `userId`: ID do usuário\n- `propertyId`: ID da propriedade\n- `transferId`: ID da transferência\n- `matriculaId`: Matrícula da propriedade",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
		"version": "2.0.0"
	},
	"item": [
		{
			"name": "Users",
			"item": [
				{
					"name": "Register User",
					"request": {
						"method": "POST",
						"header": [{"key": "Content-Type", "value": "application/json"}],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"cpf\": \"12345678900\",\n  \"nome\": \"João Silva\",\n  \"email\": \"joao@example.com\",\n  \"senha\": \"senha123\",\n  \"walletAddress\": \"0x3b59b80bef76afce7d0a0d19eeef73045a87816c\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/users/register",
							"host": ["{{baseUrl}}"],
							"path": ["api", "users", "register"]
						},
						"description": "Registra novo usuário no sistema"
					}
				},
				{
					"name": "Login",
					"request": {
						"method": "POST",
						"header": [{"key": "Content-Type", "value": "application/json"}],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"cpf\": \"12345678900\",\n  \"senha\": \"senha123\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/users/login",
							"host": ["{{baseUrl}}"],
							"path": ["api", "users", "login"]
						},
						"description": "Autentica usuário e retorna JWT token"
					}
				},
				{
					"name": "List Users",
					"request": {
						"method": "GET",
						"header": [
							{"key": "Authorization", "value": "Bearer {{jwt_token}}"}
						],
						"url": {
							"raw": "{{baseUrl}}/api/users",
							"host": ["{{baseUrl}}"],
							"path": ["api", "users"]
						},
						"description": "Lista todos os usuários (requer autenticação)"
					}
				},
				{
					"name": "Update Wallet",
					"request": {
						"method": "PUT",
						"header": [
							{"key": "Content-Type", "value": "application/json"},
							{"key": "Authorization", "value": "Bearer {{jwt_token}}"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"walletAddress\": \"0x1f5c1eb46d627c1fc6d426f0979784331b0b29e7\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/users/{{userId}}/wallet",
							"host": ["{{baseUrl}}"],
							"path": ["api", "users", "{{userId}}", "wallet"]
						},
						"description": "Atualiza endereço da wallet do usuário"
					}
				},
				{
					"name": "Get My Profile",
					"request": {
						"method": "GET",
						"header": [
							{"key": "Authorization", "value": "Bearer {{jwt_token}}"}
						],
						"url": {
							"raw": "{{baseUrl}}/api/users/me",
							"host": ["{{baseUrl}}"],
							"path": ["api", "users", "me"]
						},
						"description": "Obtém perfil do usuário autenticado"
					}
				}
			]
		},
		{
			"name": "Properties",
			"item": [
				{
					"name": "Register Property",
					"request": {
						"method": "POST",
						"header": [
							{"key": "Content-Type", "value": "application/json"},
							{"key": "Authorization", "value": "Bearer {{jwt_token}}"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"matriculaId\": 456,\n  \"proprietarioId\": 2,\n  \"endereco\": \"Rua Example, 123\",\n  \"area\": 250.5,\n  \"valorVenal\": 500000.00\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/properties/register",
							"host": ["{{baseUrl}}"],
							"path": ["api", "properties", "register"]
						},
						"description": "Registra propriedade - publica job para blockchain via RabbitMQ"
					}
				},
				{
					"name": "Get Property",
					"request": {
						"method": "GET",
						"header": [
							{"key": "Authorization", "value": "Bearer {{jwt_token}}"}
						],
						"url": {
							"raw": "{{baseUrl}}/api/properties/{{propertyId}}",
							"host": ["{{baseUrl}}"],
							"path": ["api", "properties", "{{propertyId}}"]
						},
						"description": "Obtém detalhes de uma propriedade"
					}
				},
				{
					"name": "List All Properties",
					"request": {
						"method": "GET",
						"header": [
							{"key": "Authorization", "value": "Bearer {{jwt_token}}"}
						],
						"url": {
							"raw": "{{baseUrl}}/api/properties",
							"host": ["{{baseUrl}}"],
							"path": ["api", "properties"]
						},
						"description": "Lista todas as propriedades"
					}
				},
				{
					"name": "Get My Properties",
					"request": {
						"method": "GET",
						"header": [
							{"key": "Authorization", "value": "Bearer {{jwt_token}}"}
						],
						"url": {
							"raw": "{{baseUrl}}/api/properties/my-properties",
							"host": ["{{baseUrl}}"],
							"path": ["api", "properties", "my-properties"]
						},
						"description": "Lista propriedades do usuário autenticado"
					}
				}
			]
		},
		{
			"name": "Transfers",
			"item": [
				{
					"name": "Initiate Transfer",
					"request": {
						"method": "POST",
						"header": [
							{"key": "Content-Type", "value": "application/json"},
							{"key": "Authorization", "value": "Bearer {{jwt_token}}"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"matriculaId\": 456,\n  \"sellerId\": 2,\n  \"buyerId\": 3\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/transfers/initiate",
							"host": ["{{baseUrl}}"],
							"path": ["api", "transfers", "initiate"]
						},
						"description": "Inicia transferência de propriedade - publica job para blockchain"
					}
				},
				{
					"name": "Get Transfer",
					"request": {
						"method": "GET",
						"header": [
							{"key": "Authorization", "value": "Bearer {{jwt_token}}"}
						],
						"url": {
							"raw": "{{baseUrl}}/api/transfers/{{transferId}}",
							"host": ["{{baseUrl}}"],
							"path": ["api", "transfers", "{{transferId}}"]
						},
						"description": "Obtém detalhes de uma transferência"
					}
				},
				{
					"name": "Get Transfers by Property",
					"request": {
						"method": "GET",
						"header": [
							{"key": "Authorization", "value": "Bearer {{jwt_token}}"}
						],
						"url": {
							"raw": "{{baseUrl}}/api/transfers/property/{{matriculaId}}",
							"host": ["{{baseUrl}}"],
							"path": ["api", "transfers", "property", "{{matriculaId}}"]
						},
						"description": "Lista transferências de uma propriedade"
					}
				},
				{
					"name": "Approve Transfer",
					"request": {
						"method": "POST",
						"header": [
							{"key": "Content-Type", "value": "application/json"},
							{"key": "Authorization", "value": "Bearer {{jwt_token}}"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"approved\": true,\n  \"observations\": \"Aprovado\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/transfers/{{transferId}}/approve",
							"host": ["{{baseUrl}}"],
							"path": ["api", "transfers", "{{transferId}}", "approve"]
						},
						"description": "Aprova transferência (Cartório/Prefeitura/IF)"
					}
				},
				{
					"name": "Accept Transfer (Buyer)",
					"request": {
						"method": "POST",
						"header": [
							{"key": "Authorization", "value": "Bearer {{jwt_token}}"}
						],
						"url": {
							"raw": "{{baseUrl}}/api/transfers/{{transferId}}/accept",
							"host": ["{{baseUrl}}"],
							"path": ["api", "transfers", "{{transferId}}", "accept"]
						},
						"description": "Comprador aceita a transferência"
					}
				},
				{
					"name": "List All Transfers",
					"request": {
						"method": "GET",
						"header": [
							{"key": "Authorization", "value": "Bearer {{jwt_token}}"}
						],
						"url": {
							"raw": "{{baseUrl}}/api/transfers",
							"host": ["{{baseUrl}}"],
							"path": ["api", "transfers"]
						},
						"description": "Lista todas as transferências"
					}
				}
			]
		},
		{
			"name": "Webhooks (Internal)",
			"item": [
				{
					"name": "Property Registered (Webhook)",
					"request": {
						"method": "PATCH",
						"header": [{"key": "Content-Type", "value": "application/json"}],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"transactionHash\": \"0x...\",\n  \"blockNumber\": 12345,\n  \"status\": \"SUCCESS\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/webhooks/blockchain/properties/{{propertyId}}",
							"host": ["{{baseUrl}}"],
							"path": ["api", "webhooks", "blockchain", "properties", "{{propertyId}}"]
						},
						"description": "Webhook do offchain-consumer após registro na blockchain"
					}
				},
				{
					"name": "Transfer Configured (Webhook)",
					"request": {
						"method": "POST",
						"header": [{"key": "Content-Type", "value": "application/json"}],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"transferId\": 6,\n  \"transactionHash\": \"0x...\",\n  \"blockNumber\": 12346\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/webhooks/blockchain/properties/transfer-configured",
							"host": ["{{baseUrl}}"],
							"path": ["api", "webhooks", "blockchain", "properties", "transfer-configured"]
						},
						"description": "Webhook após configuração de transferência na blockchain"
					}
				},
				{
					"name": "Transfer Executed (Webhook)",
					"request": {
						"method": "POST",
						"header": [{"key": "Content-Type", "value": "application/json"}],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"transferId\": 6,\n  \"transactionHash\": \"0x...\",\n  \"blockNumber\": 12347\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/webhooks/blockchain/properties/transferred",
							"host": ["{{baseUrl}}"],
							"path": ["api", "webhooks", "blockchain", "properties", "transferred"]
						},
						"description": "Webhook após execução de transferência na blockchain"
					}
				},
				{
					"name": "Update Transfer (Webhook)",
					"request": {
						"method": "PATCH",
						"header": [{"key": "Content-Type", "value": "application/json"}],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"status\": \"CONCLUIDA\",\n  \"transactionHash\": \"0x...\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/webhooks/blockchain/transfers/{{transferId}}",
							"host": ["{{baseUrl}}"],
							"path": ["api", "webhooks", "blockchain", "transfers", "{{transferId}}"]
						},
						"description": "Webhook para atualizar status de transferência"
					}
				}
			]
		},
